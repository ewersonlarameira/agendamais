<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lumina's Clínica Estética</title>
    <style>
        :root {
            --bg-color: #f4f4f4;
            --text-color: #1a1a1a;
            --sidebar-bg: #ffffff;
            --border-color: #cccccc;
            --hover-bg: #e0e0e0;
            --input-border: #999999;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }

        body { background-color: var(--bg-color); color: var(--text-color); height: 100vh; display: flex; justify-content: center; align-items: center; }

        /* --- ESTILOS DE LOGIN --- */
        #login-screen { background: var(--sidebar-bg); padding: 40px; border-radius: 8px; border: 1px solid var(--border-color); width: 100%; max-width: 400px; text-align: center; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        #login-screen h1 { margin-bottom: 20px; font-size: 1.5rem; }
        .input-group { margin-bottom: 15px; text-align: left; }
        .input-group label { display: block; margin-bottom: 5px; font-size: 0.9rem; font-weight: bold; }
        .input-group input, .input-group select { width: 100%; padding: 10px; border: 1px solid var(--input-border); border-radius: 4px; font-size: 1rem; background: #fff; }
        
        button.btn-primary { width: 100%; background-color: var(--text-color); color: var(--sidebar-bg); border: none; padding: 12px; font-size: 1rem; border-radius: 4px; cursor: pointer; transition: opacity 0.2s; margin-top: 10px; }
        button.btn-primary:hover { opacity: 0.8; }
        .error-msg { color: #d32f2f; font-size: 0.85rem; margin-top: 10px; display: none; }

        /* --- ESTILOS DO APP PRINCIPAL --- */
        #app-screen { display: none; width: 100%; height: 100vh; }
        aside { width: 250px; background-color: var(--sidebar-bg); border-right: 1px solid var(--border-color); display: flex; flex-direction: column; padding: 20px 0; }
        .logo { text-align: center; font-size: 1.2rem; font-weight: bold; padding-bottom: 20px; border-bottom: 1px solid var(--border-color); margin-bottom: 10px; }
        nav button { width: 100%; background: none; border: none; padding: 15px 20px; text-align: left; font-size: 1rem; cursor: pointer; color: var(--text-color); transition: background 0.2s; display: flex; align-items: center; gap: 10px; }
        nav button:hover { background-color: var(--hover-bg); }
        nav button.active { background-color: var(--text-color); color: var(--bg-color); }
        
        main { flex: 1; padding: 40px; overflow-y: auto; position: relative; }
        .view { display: none; background: var(--sidebar-bg); padding: 30px; border-radius: 8px; border: 1px solid var(--border-color); }
        .view.active { display: block; }
        h2 { margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px solid var(--border-color); }

        .form-row { display: flex; gap: 15px; margin-bottom: 15px; }
        .form-row .input-group { flex: 1; margin-bottom: 0; }
        .checkbox-group { margin-top: 15px; border: 1px solid var(--border-color); padding: 15px; border-radius: 4px; }
        .checkbox-group h4 { margin-bottom: 10px; }
        .checkbox-list label { display: block; margin-bottom: 8px; cursor: pointer; }

        /* Grade da Agenda */
        .agenda-grid { border: 1px solid var(--border-color); border-radius: 4px; overflow: hidden; }
        .agenda-row { display: flex; border-bottom: 1px solid var(--border-color); }
        .agenda-row:last-child { border-bottom: none; }
        .agenda-time { width: 80px; padding: 15px; background: var(--hover-bg); font-weight: bold; text-align: center; border-right: 1px solid var(--border-color); }
        .agenda-slot { flex: 1; padding: 15px; cursor: pointer; transition: background 0.2s; display: flex; justify-content: space-between; align-items: center; }
        .agenda-slot:hover { background: #f9f9f9; }
        .agenda-slot.ocupado { background: var(--text-color); color: var(--sidebar-bg); cursor: default; }
        .agenda-slot.continuacao { background: #333; color: #ccc; cursor: default; }
        .btn-cancelar { background: #d32f2f; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 0.8rem; }

        /* Tabelas */
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { padding: 12px; border-bottom: 1px solid var(--border-color); text-align: left; }
        th { background-color: var(--bg-color); }

        /* Modal */
        .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; z-index: 1000; }
        .modal-content { background: var(--sidebar-bg); padding: 30px; border-radius: 8px; width: 400px; box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
        .close-btn { float: right; cursor: pointer; font-size: 1.5rem; font-weight: bold; line-height: 1; }
    </style>
</head>
<body>

    <!-- TELA DE LOGIN -->
    <div id="login-screen">
        <h1>✨ Lumina's Estética</h1>
        <p style="margin-bottom: 20px; color: #666; font-size: 0.9rem;">Área Restrita</p>
        <div class="input-group"><label>Nickname</label><input type="text" id="login-nick" placeholder="Ex: admin"></div>
        <div class="input-group"><label>Senha (8 dígitos)</label><input type="password" id="login-senha" maxlength="8" placeholder="********"></div>
        <button class="btn-primary" onclick="fazerLogin()">Entrar</button>
        <p id="login-error" class="error-msg">Credenciais inválidas. Tente admin / 12345678</p>
    </div>

    <!-- APP PRINCIPAL -->
    <div id="app-screen">
        <aside>
            <div class="logo">Lumina's Estética</div>
            <nav>
                <button onclick="changeView('agenda')" id="menu-agenda" class="menu-item active">📅 Agenda</button>
                <button onclick="changeView('pacientes')" id="menu-pacientes" class="menu-item">👥 Pacientes</button>
                <button onclick="changeView('procedimentos')" id="menu-procedimentos" class="menu-item">✨ Procedimentos</button>
                <button onclick="changeView('profissionais')" id="menu-profissionais" class="menu-item">👩‍⚕️ Profissionais</button>
                <button onclick="changeView('configuracoes')" id="menu-configuracoes" class="menu-item">⚙️ Configurações</button>
            </nav>
            <button onclick="fazerLogout()" style="margin-top: auto; color: #666; background: none; border: none; padding: 15px; cursor: pointer;">🚪 Sair</button>
        </aside>

        <main>
            <div id="agenda" class="view active">
                <h2>📅 Agenda do Dia</h2>
                <div class="agenda-grid" id="grade-agenda"></div>
            </div>

            <div id="pacientes" class="view">
                <h2>👥 Cadastro de Pacientes</h2>
                <div class="form-row">
                    <div class="input-group"><label>Nome Completo</label><input type="text" id="pac-nome" placeholder="Ex: Maria Oliveira"></div>
                    <div class="input-group"><label>WhatsApp</label><input type="text" id="pac-whatsapp" placeholder="Ex: (11) 99999-9999"></div>
                </div>
                <button class="btn-primary" style="width: auto; padding: 10px 30px;" onclick="salvarPaciente()">Cadastrar Paciente</button>
                <h3 style="margin-top: 40px; margin-bottom: 10px;">📋 Lista de Pacientes</h3>
                <table><thead><tr><th>Nome</th><th>WhatsApp</th></tr></thead><tbody id="tabela-pacientes"></tbody></table>
            </div>

            <div id="procedimentos" class="view">
                <h2>✨ Catálogo de Procedimentos</h2>
                <div class="form-row">
                    <div class="input-group"><label>Nome do Serviço</label><input type="text" id="proc-nome"></div>
                    <div class="input-group">
                        <label>Duração</label>
                        <select id="proc-duracao"><option value="1">1 Hora</option><option value="2">2 Horas</option></select>
                    </div>
                    <div class="input-group"><label>Valor (R$)</label><input type="number" id="proc-valor"></div>
                </div>
                <button class="btn-primary" style="width: auto; padding: 10px 30px;" onclick="salvarProcedimento()">Salvar Procedimento</button>
                <h3 style="margin-top: 40px; margin-bottom: 10px;">📋 Serviços Cadastrados</h3>
                <table><thead><tr><th>Procedimento</th><th>Duração</th><th>Valor</th></tr></thead><tbody id="tabela-procedimentos"></tbody></table>
            </div>

            <div id="profissionais" class="view">
                <h2>👩‍⚕️ Cadastro de Profissional</h2>
                <div class="form-row">
                    <div class="input-group"><label>Nome Completo</label><input type="text" id="cad-nome"></div>
                    <div class="input-group"><label>Especialidade</label><input type="text" id="cad-especialidade"></div>
                </div>
                <div class="form-row">
                    <div class="input-group"><label>Nickname de Acesso</label><input type="text" id="cad-nick"></div>
                    <div class="input-group"><label>Senha (8 dígitos)</label><input type="text" id="cad-senha" maxlength="8"></div>
                </div>
                <div class="checkbox-group">
                    <h4>Permissões de Acesso:</h4>
                    <div class="checkbox-list">
                        <label><input type="checkbox" id="perm-agenda" checked> 📅 Agenda</label>
                        <label><input type="checkbox" id="perm-pacientes" checked> 👥 Pacientes</label>
                        <label><input type="checkbox" id="perm-procedimentos"> ✨ Procedimentos</label>
                        <label><input type="checkbox" id="perm-profissionais"> 👩‍⚕️ Profissionais</label>
                        <label><input type="checkbox" id="perm-configuracoes"> ⚙️ Configurações</label>
                    </div>
                </div>
                <button class="btn-primary" style="margin-top: 20px; width: auto; padding: 10px 30px;" onclick="salvarProfissional()">Salvar Profissional</button>
            </div>

            <div id="configuracoes" class="view">
                <h2>⚙️ Configurações</h2>
                <p>O painel de conexão com o banco de dados Supabase será implementado aqui.</p>
            </div>
        </main>
    </div>

    <!-- MODAL NOVO AGENDAMENTO -->
    <div id="modal-agendamento" class="modal-overlay">
        <div class="modal-content">
            <span class="close-btn" onclick="fecharModal()">&times;</span>
            <h2 style="border-bottom: none; margin-bottom: 5px;">📅 Agendar Horário</h2>
            <p id="modal-horario" style="margin-bottom: 20px; font-weight: bold; color: #666;"></p>

            <div class="input-group">
                <label>Paciente</label>
                <select id="modal-paciente"><option value="">Selecione um paciente...</option></select>
            </div>
            <div class="input-group">
                <label>Procedimento</label>
                <select id="modal-procedimento"><option value="">Selecione um procedimento...</option></select>
            </div>
            <button class="btn-primary" onclick="confirmarAgendamento()">Confirmar Agendamento</button>
        </div>
    </div>

    <script>
        // --- BANCOS DE DADOS ---
        const usuariosDB = [{ nick: 'admin', senha: '12345678', permissoes: ['agenda', 'pacientes', 'procedimentos', 'profissionais', 'configuracoes'] }];
        const pacientesDB = [];
        const procedimentosDB = [
            { nome: 'Limpeza de Pele', duracao: 1, valor: 120 },
            { nome: 'Protocolo Lumina (Longo)', duracao: 2, valor: 250 } // Exemplo de 2 horas
        ];
        const agendamentosDB = []; 
        let horaSelecionadaParaAgendamento = '';
        const HORARIOS_AGENDA = ['08:00', '09:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00', '16:00', '17:00', '18:00'];

        atualizarListaPacientes();
        atualizarListaProcedimentos();

        // --- LÓGICA DE LOGIN ---
        function fazerLogin() {
            const nickInput = document.getElementById('login-nick').value;
            const senhaInput = document.getElementById('login-senha').value;
            const usuarioLogado = usuariosDB.find(u => u.nick === nickInput && u.senha === senhaInput);

            if (usuarioLogado) {
                document.getElementById('login-screen').style.display = 'none';
                document.body.style.display = 'block'; 
                document.getElementById('app-screen').style.display = 'flex';
                document.getElementById('login-error').style.display = 'none';
                aplicarPermissoes(usuarioLogado.permissoes);
                gerarGradeAgenda();
            } else {
                document.getElementById('login-error').style.display = 'block';
            }
        }

        function fazerLogout() {
            document.body.style.display = 'flex';
            document.getElementById('login-screen').style.display = 'block';
            document.getElementById('app-screen').style.display = 'none';
            document.getElementById('login-nick').value = '';
            document.getElementById('login-senha').value = '';
        }

        function aplicarPermissoes(permissoes) {
            ['agenda', 'pacientes', 'procedimentos', 'profissionais', 'configuracoes'].forEach(menu => {
                const btn = document.getElementById('menu-' + menu);
                btn.style.display = permissoes.includes(menu) ? 'flex' : 'none';
            });
            changeView(permissoes[0] || 'agenda');
        }

        function changeView(viewId) {
            document.querySelectorAll('.view').forEach(view => view.classList.remove('active'));
            document.querySelectorAll('.menu-item').forEach(btn => btn.classList.remove('active'));
            document.getElementById(viewId).classList.add('active');
            document.getElementById('menu-' + viewId).classList.add('active');
        }

        // --- LÓGICA DE PACIENTES ---
        function salvarPaciente() {
            const nome = document.getElementById('pac-nome').value.trim();
            const whatsapp = document.getElementById('pac-whatsapp').value.trim();
            if(!nome) return alert("O nome do paciente é obrigatório!");
            pacientesDB.push({ nome, whatsapp });
            document.getElementById('pac-nome').value = '';
            document.getElementById('pac-whatsapp').value = '';
            atualizarListaPacientes();
            alert("Paciente cadastrado com sucesso!");
        }

        function atualizarListaPacientes() {
            const tbody = document.getElementById('tabela-pacientes');
            const selectPaciente = document.getElementById('modal-paciente');
            tbody.innerHTML = '';
            selectPaciente.innerHTML = '<option value="">Selecione um paciente...</option>';
            if (pacientesDB.length === 0) {
                tbody.innerHTML = `<tr><td colspan="2" style="text-align:center; color:#666;">Nenhum paciente cadastrado ainda.</td></tr>`;
            } else {
                pacientesDB.forEach(paciente => {
                    tbody.innerHTML += `<tr><td>${paciente.nome}</td><td>${paciente.whatsapp || '-'}</td></tr>`;
                    selectPaciente.innerHTML += `<option value="${paciente.nome}">${paciente.nome}</option>`;
                });
            }
        }

        // --- LÓGICA DE PROCEDIMENTOS ---
        function salvarProcedimento() {
            const nome = document.getElementById('proc-nome').value.trim();
            const duracao = parseInt(document.getElementById('proc-duracao').value);
            const valor = document.getElementById('proc-valor').value.trim();
            if(!nome) return alert("O nome do procedimento é obrigatório!");
            procedimentosDB.push({ nome, duracao, valor: valor || 0 });
            document.getElementById('proc-nome').value = '';
            document.getElementById('proc-valor').value = '';
            atualizarListaProcedimentos();
            alert("Procedimento salvo com sucesso!");
        }

        function atualizarListaProcedimentos() {
            const tbody = document.getElementById('tabela-procedimentos');
            const selectProcedimento = document.getElementById('modal-procedimento');
            tbody.innerHTML = '';
            selectProcedimento.innerHTML = '<option value="">Selecione um procedimento...</option>';
            if (procedimentosDB.length === 0) {
                tbody.innerHTML = `<tr><td colspan="3" style="text-align:center; color:#666;">Nenhum procedimento cadastrado.</td></tr>`;
            } else {
                procedimentosDB.forEach(proc => {
                    const textoDuracao = proc.duracao === 1 ? '1 Hora' : `${proc.duracao} Horas`;
                    tbody.innerHTML += `<tr><td>${proc.nome}</td><td>${textoDuracao}</td><td>${proc.valor > 0 ? 'R$ '+proc.valor : '-'}</td></tr>`;
                    selectProcedimento.innerHTML += `<option value="${proc.nome}">${proc.nome} (${textoDuracao})</option>`;
                });
            }
        }

        // --- LÓGICA DA AGENDA (COM TRAVA DE TEMPO) ---
        function gerarGradeAgenda() {
            const container = document.getElementById('grade-agenda');
            container.innerHTML = ''; 
            
            HORARIOS_AGENDA.forEach(hora => {
                const row = document.createElement('div');
                row.className = 'agenda-row';

                const timeDiv = document.createElement('div');
                timeDiv.className = 'agenda-time';
                timeDiv.textContent = hora;

                const slotDiv = document.createElement('div');
                slotDiv.className = 'agenda-slot';
                
                const agendamento = agendamentosDB.find(a => a.hora === hora);

                if (hora === '12:00') {
                    slotDiv.textContent = 'Almoço (Bloqueado)';
                    slotDiv.classList.add('ocupado');
                } else if (agendamento) {
                    if (agendamento.isContinuacao) {
                        slotDiv.innerHTML = `<span>↳ Continuação de: <b>${agendamento.paciente}</b></span>`;
                        slotDiv.classList.add('continuacao');
                    } else {
                        slotDiv.innerHTML = `<span>👥 <b>${agendamento.paciente}</b> - ${agendamento.procedimento}</span>`;
                        slotDiv.classList.add('ocupado');
                        
                        const btnCancelar = document.createElement('button');
                        btnCancelar.className = 'btn-cancelar';
                        btnCancelar.textContent = 'Cancelar';
                        btnCancelar.onclick = (e) => cancelarAgendamento(agendamento.idAgendamento, e);
                        slotDiv.appendChild(btnCancelar);
                    }
                } else {
                    slotDiv.textContent = 'Livre - Clique para agendar';
                    slotDiv.onclick = () => abrirModalAgendamento(hora);
                }

                row.appendChild(timeDiv);
                row.appendChild(slotDiv);
                container.appendChild(row);
            });
        }

        function abrirModalAgendamento(hora) {
            horaSelecionadaParaAgendamento = hora;
            document.getElementById('modal-horario').textContent = `Horário Selecionado: ${hora}`;
            document.getElementById('modal-agendamento').style.display = 'flex';
        }

        function fecharModal() {
            document.getElementById('modal-agendamento').style.display = 'none';
            document.getElementById('modal-paciente').value = '';
            document.getElementById('modal-procedimento').value = '';
        }

        function confirmarAgendamento() {
            const paciente = document.getElementById('modal-paciente').value;
            const procedimentoNome = document.getElementById('modal-procedimento').value;

            if(!paciente || !procedimentoNome) return alert("Por favor, selecione um paciente e um procedimento.");

            // Busca os detalhes do procedimento para saber a duração
            const procDetalhes = procedimentosDB.find(p => p.nome === procedimentoNome);
            const duracao = procDetalhes ? procDetalhes.duracao : 1;
            const idUnico = Date.now(); // Cria um ID para agrupar agendamentos de 2h

            // TRAVA DE CONFLITOS (Para procedimentos de 2 horas)
            if (duracao > 1) {
                const indexAtual = HORARIOS_AGENDA.indexOf(horaSelecionadaParaAgendamento);
                const proximaHora = HORARIOS_AGENDA[indexAtual + 1];

                // Verifica se a próxima hora não existe (ex: fim do dia) ou é o almoço
                if (!proximaHora || proximaHora === '12:00') {
                    return alert("Não há tempo suficiente antes do almoço ou do fim do expediente para este procedimento de 2 horas.");
                }

                // Verifica se a próxima hora já está ocupada por outro paciente
                if (agendamentosDB.find(a => a.hora === proximaHora)) {
                    return alert("O próximo horário já está ocupado. Escolha um horário com 2 horas livres.");
                }

                // Salva o bloco da segunda hora (Continuação)
                agendamentosDB.push({
                    idAgendamento: idUnico,
                    hora: proximaHora,
                    paciente: paciente,
                    procedimento: procedimentoNome,
                    isContinuacao: true
                });
            }

            // Salva a primeira hora
            agendamentosDB.push({
                idAgendamento: idUnico,
                hora: horaSelecionadaParaAgendamento,
                paciente: paciente,
                procedimento: procedimentoNome,
                isContinuacao: false
            });

            fecharModal();
            gerarGradeAgenda(); 
        }

        function cancelarAgendamento(idAgendamento, event) {
            event.stopPropagation(); 
            if(confirm(`Tem certeza que deseja cancelar este agendamento?`)) {
                // Filtra o banco removendo todas as horas vinculadas a este ID (exclui blocos de 1h ou 2h inteiros)
                const indexList = agendamentosDB.filter(a => a.idAgendamento === idAgendamento);
                indexList.forEach(item => {
                    const idx = agendamentosDB.indexOf(item);
                    agendamentosDB.splice(idx, 1);
                });
                gerarGradeAgenda();
            }
        }
    </script>
</body>
</html>
